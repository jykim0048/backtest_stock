# --- LLM (see llm.py) ---
# Primary provider. Gemini has a free tier; get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: override the fallback chain (priority order, comma-separated provider:model).
# A link whose key is missing is skipped. Default:
#   gemini:gemini-2.5-flash,gemini:gemini-2.0-flash,gemini:gemini-2.5-flash-lite
# Append anthropic:claude-sonnet-4-6 to fall back to Claude when Gemini is exhausted.
# LLM_CHAIN=gemini:gemini-2.5-flash,gemini:gemini-2.0-flash,anthropic:claude-sonnet-4-6
# Only needed if "anthropic:" appears in LLM_CHAIN.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- data sources ---
DART_API_KEY=your_dart_opendart_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
NAVER_CLIENT_ID=your_naver_client_id_here
NAVER_CLIENT_SECRET=your_naver_client_secret_here
FRED_API_KEY=your_fred_api_key_here
