# --- LLM (see llm.py) ---
# Primary provider. Gemini has a free tier; get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: override the fallback chain (priority order, comma-separated provider:model).
# A link whose key is missing is skipped. Default:
#   gemini:gemini-3.5-flash,gemini:gemini-3.1-flash-lite,gemini:gemini-3-flash-preview,gemini:gemini-2.5-flash,gemini:gemini-2.5-flash-lite
# Append anthropic:claude-sonnet-4-6 to fall back to Claude when Gemini is exhausted.
# LLM_CHAIN=gemini:gemini-3.5-flash,gemini:gemini-2.5-flash,anthropic:claude-sonnet-4-6
# Only needed if "anthropic:" appears in LLM_CHAIN.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- data sources ---
DART_API_KEY=your_dart_opendart_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
NAVER_CLIENT_ID=your_naver_client_id_here
NAVER_CLIENT_SECRET=your_naver_client_secret_here
FRED_API_KEY=your_fred_api_key_here

# --- on-demand Deep Research service (railway_server.py, e.g. on Railway) ---
# The dashboard search box calls a persistent server that reuses the SAME keys
# above (GEMINI/DART/NAVER/TAVILY) — no extra variables needed. Railway injects
# PORT automatically. Set RESEARCH_API_BASE in public/index.html to its public URL.

# --- scheduled GitHub Actions trigger (railway_server._scheduler) ---
# The always-on server fires workflow_dispatch at exact KST times (장전 07:43,
# 장중 09:07~14:37) because GitHub's own schedule: delays/drops. Requires a
# fine-grained PAT with this repo's "Actions: Read and write" permission.
GH_DISPATCH_TOKEN=your_github_fine_grained_pat_here
# Optional overrides (defaults shown):
# GH_REPO=jykim0048/backtest_stock
# GH_REF=main
